{
  "type": "record",
  "name": "QualityEvent",
  "namespace": "io.celltrace.events",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "event_type", "type": "string"},
    {"name": "schema_version", "type": "int"},
    {"name": "occurred_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "correlation_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causation_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
    {"name": "producer", "type": "string"},
    {"name": "actor", "type": "string"},
    {"name": "payload", "type": [
      {
        "type": "record",
        "name": "QualityHoldPlacedPayload",
        "fields": [
          {"name": "hold_id", "type": {"type": "string", "logicalType": "uuid"}},
          {"name": "serial", "type": "string"},
          {"name": "reason_code", "type": "string"}
        ]
      },
      {
        "type": "record",
        "name": "QualityHoldReleasedPayload",
        "fields": [
          {"name": "hold_id", "type": {"type": "string", "logicalType": "uuid"}},
          {"name": "serial", "type": "string"},
          {"name": "release_comment", "type": "string"}
        ]
      }
    ]}
  ]
}
